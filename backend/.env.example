PORT=4000
NODE_ENV=development

# Google Maps API Key (Mesafe ve Trafik Matrisi için)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Firebase Konfigürasyonu
# FIREBASE_SERVICE_ACCOUNT_KEY ve FIRESTORE_EMULATOR_HOST tanımlı değilse backend otomatik olarak
# yerel mock veritabanını (backend/.local-db.json) kullanır. Gerçek Firestore'u zorlamak için USE_LOCAL_DB=false.
# USE_LOCAL_DB=true
# LOCAL_DB_FILE=./.local-db.json
FIREBASE_PROJECT_ID=arya-pet-nakil
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
