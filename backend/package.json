{
  "name": "arya-pet-nakil-backend",
  "version": "1.0.0",
  "description": "Arya Pet Nakil Rezervasyon ve Fiyatlandırma Backend Servisi",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "simulate": "ts-node-dev --transpile-only src/test-simulation.ts",
    "seed:local": "ts-node-dev --transpile-only src/seed-local.ts",
    "test": "node --require ts-node/register --test src/pricing.test.ts src/local-db.test.ts src/api.test.ts"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
